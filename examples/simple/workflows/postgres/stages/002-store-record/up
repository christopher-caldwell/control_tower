#!/usr/bin/env -S uv run python
import json
import os
from pathlib import Path
import psycopg

workflow = Path(os.environ["CONTROL_TOWER_WORKFLOW"])
data = workflow / "data"
result = json.loads((data / "record.json").read_text())
run_id = os.environ["CONTROL_TOWER_UUID"]
# Commit the actual database write before saving its local receipt. A retry after
# receipt failure accepts the same row but refuses to overwrite unexpected values.
with psycopg.connect(os.environ["GALLERY_POSTGRES_DSN"], connect_timeout=5) as connection:
    connection.execute(
        "INSERT INTO public.gallery_records (run_id, record_id, label) VALUES (%s, %s, %s) "
        "ON CONFLICT (run_id) DO NOTHING",
        (run_id, result["record_id"], result["label"]),
    )
    row = connection.execute(
        "SELECT record_id, label FROM public.gallery_records WHERE run_id = %s", (run_id,)
    ).fetchone()
    if row != (result["record_id"], result["label"]):
        raise RuntimeError("run already has a different database record; inspect before retrying")
(data / "postgres_receipt.json").write_text(json.dumps({"run_id": run_id, **result}, indent=2) + "\n")
