#!/usr/bin/env -S uv run python
import json
import os
from pathlib import Path
workspace = Path(os.environ["CONTROL_TOWER_WORKSPACE"])
record = json.loads((workspace / "data" / "record.json").read_text())
if record != {"id": 123, "label": "  example record  ", "created_at": "2026-01-02T03:04:05+00:00"}:
    raise SystemExit("seeded record does not match expected fixture")
