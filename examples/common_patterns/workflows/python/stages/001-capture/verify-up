#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path
from unittest import TestCase

sys.path.insert(0, str(Path(os.environ["CONTROL_TOWER_WORKFLOW"]).parents[1] / "lib/python"))
from patterns import load_value

check = TestCase()

saved = load_value("generated")
check.assertTrue(isinstance(saved["id"], str) and bool(saved["id"]), "generated id")
check.assertEqual(json.loads(saved["captured_stdout"])["id"], saved["id"], "captured evidence")
