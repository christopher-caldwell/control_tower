#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(os.environ["CONTROL_TOWER_WORKFLOW"]).parents[1] / "lib/python"))
from patterns import load_value, require_equal

saved = load_value("generated")
require_equal(isinstance(saved["id"], str) and bool(saved["id"]), True, "generated id")
require_equal(json.loads(saved["captured_stdout"])["id"], saved["id"], "captured evidence")
