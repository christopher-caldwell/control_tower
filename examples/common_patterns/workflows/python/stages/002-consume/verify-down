#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path
from unittest import TestCase

sys.path.insert(0, str(Path(os.environ["CONTROL_TOWER_WORKFLOW"]).parents[1] / "lib/python"))
from patterns import load_value, require_absent_value

check = TestCase()

generated = load_value("generated")
check.assertTrue(isinstance(generated["id"], str) and bool(generated["id"]), "generated id")
check.assertEqual(json.loads(generated["captured_stdout"])["id"], generated["id"], "captured evidence")
require_absent_value("verified")
