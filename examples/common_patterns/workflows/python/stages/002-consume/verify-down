#!/usr/bin/env python3
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(os.environ["CONTROL_TOWER_WORKFLOW"]).parents[1] / "lib/python"))
from patterns import load_value, require_absent_value, require_equal

generated = load_value("generated")
require_equal(isinstance(generated["id"], str) and bool(generated["id"]), True, "generated id")
require_equal(json.loads(generated["captured_stdout"])["id"], generated["id"], "captured evidence")
require_absent_value("verified")
