#!/usr/bin/env python3
import os
import sys
from pathlib import Path
from unittest import TestCase

sys.path.insert(0, str(Path(os.environ["CONTROL_TOWER_WORKFLOW"]).parents[1] / "lib/python"))
from patterns import capture, load_value, require_success, save_value

check = TestCase()

saved = load_value("generated")
result = require_success(capture(sys.executable, "-c", f"print({saved['id']!r})"))
check.assertEqual(result.stdout.strip(), saved["id"], "consumed value")
save_value("verified", result.stdout.strip())
