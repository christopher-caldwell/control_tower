#!/usr/bin/env node
import assert from "node:assert/strict";
import { loadValue, requireAbsentValue } from "../../../../lib/node/index.mjs";

const generated = await loadValue("generated");
assert.equal(typeof generated.id, "string", "generated id type");
assert.ok(generated.id, "generated id must not be empty");
assert.equal(JSON.parse(generated.captured_stdout).id, generated.id, "captured evidence");
await requireAbsentValue("verified");
