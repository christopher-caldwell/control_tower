#!/usr/bin/env node
import assert from "node:assert/strict";
import { capture, loadValue, requireSuccess, saveValue } from "../../../../lib/node/index.mjs";

const saved = await loadValue("generated");
const result = requireSuccess(await capture(process.execPath, "-e", `process.stdout.write(${JSON.stringify(saved.id)})`));
assert.equal(result.stdout, saved.id, "consumed value");
await saveValue("verified", result.stdout);
