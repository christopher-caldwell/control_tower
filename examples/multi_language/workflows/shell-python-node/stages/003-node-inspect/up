#!/usr/bin/env node
const fs = require("fs");
const path = require("path");
const dayjs = require("dayjs");
dayjs.extend(require("dayjs/plugin/utc"));
const workflow = process.env.CONTROL_TOWER_WORKFLOW;
const data = path.join(workflow, "data");
const record = JSON.parse(fs.readFileSync(path.join(data, "record.json"), "utf8"));
const result = JSON.parse(fs.readFileSync(path.join(data, "normalized.json"), "utf8"));
fs.writeFileSync(
  path.join(data, "node_inspection.json"),
  JSON.stringify({runtime: "node", recordId: result.record_id, label: result.label, createdDate: dayjs.utc(record.created_at).format("YYYY-MM-DD")}, null, 2) + "\n"
);
