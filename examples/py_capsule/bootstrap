#!/bin/sh
# Prepare only the shared category, tool child, and explicit isolation exception.
set -eu
GALLERY_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
unset UV_PROJECT UV_PROJECT_ENVIRONMENT UV_NO_SYNC UV_FROZEN VIRTUAL_ENV PYTHONPATH
export PYTHONDONTWRITEBYTECODE=1
uv sync --locked --project "$GALLERY_ROOT" --group dev
uv sync --locked --project "$GALLERY_ROOT/tools/example_tool"
uv sync --locked --project "$GALLERY_ROOT/isolated-python-stage/stages/003-inspect"
npm ci --prefix "$GALLERY_ROOT" --ignore-scripts --no-audit --no-fund
printf 'Ready. Build Control Tower with cargo build --locked --workspace from the repository root.\n'
