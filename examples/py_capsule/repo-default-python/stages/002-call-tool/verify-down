#!/usr/bin/env -S uv run python
import os
from pathlib import Path
workspace = Path(os.environ["CONTROL_TOWER_WORKSPACE"])
if (workspace / "data" / "tool_result.json").exists():
    raise SystemExit("tool_result.json still exists after reversal")
if (workspace / "data" / "runtime_context.json").exists():
    raise SystemExit("runtime_context.json still exists after reversal")
