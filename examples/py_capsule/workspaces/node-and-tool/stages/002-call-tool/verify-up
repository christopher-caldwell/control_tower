#!/usr/bin/env -S uv run python
import json
import os
from pathlib import Path
workspace = Path(os.environ["CONTROL_TOWER_WORKSPACE"])
data = workspace / "data"
result = json.loads((data / "tool_result.json").read_text())
context = json.loads((data / "runtime_context.json").read_text())
if result != {"record_id": "123", "label": "EXAMPLE RECORD"}:
    raise SystemExit("tool result does not match expected normalized record")
if context["session"]["values"].get("last_record_id") != "123":
    raise SystemExit("runtime context did not retain the record id")
if context["conversation"]["metadata"].get("last_tool") != "normalize_record":
    raise SystemExit("runtime context did not retain the tool marker")
