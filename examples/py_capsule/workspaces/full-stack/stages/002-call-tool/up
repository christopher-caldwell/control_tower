#!/usr/bin/env -S uv run python
import json
import os
from pathlib import Path
from example_tool import normalize_record

workspace = Path(os.environ["CONTROL_TOWER_WORKSPACE"])
data = workspace / "data"
record = json.loads((data / "record.json").read_text())
context_path = data / "runtime_context.json"

result = normalize_record(
    record_id=str(record["id"]),
    label=record["label"],
    # This scenario starts a fresh runtime; the export below is an output.
    runtime_context={},
)
(data / "tool_result.json").write_text(json.dumps(result.value, indent=2) + "\n")
context_path.write_text(json.dumps(result.runtime_export, indent=2) + "\n")
