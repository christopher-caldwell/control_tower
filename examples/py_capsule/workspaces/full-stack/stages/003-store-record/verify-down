#!/usr/bin/env -S uv run python
import os
from pathlib import Path
import psycopg

workspace = Path(os.environ["CONTROL_TOWER_WORKSPACE"])
with psycopg.connect(os.environ["GALLERY_POSTGRES_DSN"], connect_timeout=5) as connection:
    connection.read_only = True
    row = connection.execute(
        "SELECT record_id FROM public.gallery_records WHERE run_id = %s", (os.environ["CONTROL_TOWER_UUID"],)
    ).fetchone()
if row is not None or (workspace / "data/postgres_receipt.json").exists():
    raise SystemExit("database row or receipt remains after reversal")
