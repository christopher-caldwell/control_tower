#!/usr/bin/env -S uv run python
import os
from pathlib import Path
import psycopg

workspace = Path(os.environ["CONTROL_TOWER_WORKSPACE"])
# Reverse the external write itself, scoped to this run. Keep the receipt if the
# database operation fails; missing local evidence is never proof of compensation.
with psycopg.connect(os.environ["GALLERY_POSTGRES_DSN"], connect_timeout=5) as connection:
    connection.execute(
        "DELETE FROM public.gallery_records WHERE run_id = %s", (os.environ["CONTROL_TOWER_UUID"],)
    )
(workspace / "data/postgres_receipt.json").unlink(missing_ok=True)
