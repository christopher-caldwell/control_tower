#!/usr/bin/env -S uv run python
import json
import os
from pathlib import Path
from jsonschema import validate
workspace = Path(os.environ["CONTROL_TOWER_WORKSPACE"])
data = workspace / "data"
result = json.loads((data / "tool_result.json").read_text())
context = json.loads((data / "runtime_context.json").read_text())
# Only this inspection stage needs JSON Schema; its environment owns that dependency.
validate(result, {
    "type": "object",
    "properties": {"record_id": {"type": "string"}, "label": {"type": "string"}},
    "required": ["record_id", "label"],
    "additionalProperties": False,
})
(data / "inspection.json").write_text(
    json.dumps({
        "result": result,
        "last_record_id": context["session"]["values"]["last_record_id"],
        "last_tool": context["conversation"]["metadata"]["last_tool"],
    }, indent=2) + "\n"
)
