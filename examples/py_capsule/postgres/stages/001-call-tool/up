#!/usr/bin/env -S uv run python
import json
import os
from pathlib import Path
from example_tool import normalize_record

workspace = Path(os.environ["CONTROL_TOWER_WORKSPACE"])
data = workspace / "data"
data.mkdir(parents=True, exist_ok=True)
result = normalize_record(record_id="123", label="  example record  ")
(data / "tool_result.json").write_text(json.dumps(result.value, indent=2) + "\n")
(data / "runtime_context.json").write_text(json.dumps(result.runtime_export, indent=2) + "\n")
