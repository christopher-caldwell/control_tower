#!/bin/sh
set -eu
# Control Tower runs this role from the stage directory. psql executes the file.
PGCONNECT_TIMEOUT=5 PGOPTIONS="-c default_transaction_read_only=on" \
psql -X --no-password "$GALLERY_POSTGRES_DSN" --set=ON_ERROR_STOP=1 --set=run_id="$CONTROL_TOWER_UUID" \
  --quiet --tuples-only --no-align --file ./inspect.sql \
  > "$CONTROL_TOWER_WORKFLOW/data/psql_file.json"
if [ ! -s "$CONTROL_TOWER_WORKFLOW/data/psql_file.json" ]; then
  printf '%s\n' 'No database row found for this run.' >&2
  exit 1
fi
