#!/usr/bin/env -S uv run python
import os
from pathlib import Path
workflow = Path(os.environ["CONTROL_TOWER_WORKFLOW"])
if (workflow / "data" / "tool_result.json").exists():
    raise SystemExit("tool_result.json still exists after reversal")
if (workflow / "data" / "runtime_context.json").exists():
    raise SystemExit("runtime_context.json still exists after reversal")
