#!/usr/bin/env -S uv run python
import json
import os
from pathlib import Path
workflow = Path(os.environ["CONTROL_TOWER_WORKFLOW"])
inspection = json.loads((workflow / "data" / "inspection.json").read_text())
if inspection["last_record_id"] != "123":
    raise SystemExit("inspection did not observe the propagated record id")
if inspection["last_tool"] != "normalize_record":
    raise SystemExit("inspection did not observe runtime metadata")
if inspection["result"] != {"record_id": "123", "label": "EXAMPLE RECORD"}:
    raise SystemExit("inspection did not retain the normalized result")
